# Production .env pro docker-compose.prod.yml
# Zkopíruj na .env a vyplň skutečné hodnoty
# DO REPOZITARE NIKDY NECOMMITUJ!

# Doména (bez https://, bez koncového /)
DOMAIN=fitbud.example.com

# PostgreSQL — vygeneruj silné heslo!
# např. node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PGUSER=fitbud
PGPASSWORD=VYGENERUJ_SILNE_HESLO
PGDATABASE=fitbud

# JWT Secret — povinně 32+ znaků, ideálně 96+
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=VYGENERUJ_NAHODNY_RETEZEC_MIN_32_ZNAKU
