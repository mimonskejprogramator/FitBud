# docker-compose .env (lokální, gitignored)
# Zkopíruj na .env a doplň hodnoty

NODE_ENV=development

# PostgreSQL credentials (sdílené mezi db a server kontejnerem)
PGUSER=fitbud
PGPASSWORD=fitbud
PGDATABASE=fitbud

# JWT Secret - vygeneruj přes:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=zmen_me_pred_spustenim

# CORS – povolené origins pro server (čárkou oddělené)
CORS_ORIGIN=http://localhost:5173

# URL backendu pro Vite klienta
VITE_API_URL=http://localhost:3000
