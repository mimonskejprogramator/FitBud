PORT=3000
NODE_ENV=development

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=fitbud
PGPASSWORD=fitbud
PGDATABASE=fitbud
# nebo místo PG* použij celé URL:
# DATABASE_URL=postgres://fitbud:fitbud@localhost:5432/fitbud

# JWT Secret - v produkci použij silný náhodný string
# Pro vygenerování můžeš použít: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=zmen_me_pred_spustenim

# Povolené origins pro CORS (čárkou oddělené)
CORS_ORIGIN=http://localhost:5173

